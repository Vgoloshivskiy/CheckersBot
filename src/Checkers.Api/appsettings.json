{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Engine": {
    "Type": "kingsrow",
    "HostPath": "engine-host\\Checkers.Engine.KingsRowHost.exe",
    "Home": "C:\\engines\\kingsrow",
    "Databases": "C:\\tb\\chinook",
    "Workers": 2,
    "HashMb": 128,
    "DatabaseCacheMb": 256,
    "StartupTimeoutSeconds": 180,
    "StopGraceMs": 2000
  },
  "Cache": { "Capacity": 20000, "TtlMinutes": 15 },
  "Limits": { "DefaultSoftTimeMs": 300, "DefaultHardTimeMs": 1200, "TablebaseProbeMs": 40 },
  "Levels": {
    "Weak": { "MaxDepth": 8, "SoftTimeMs": 100 },
    "Medium": { "MaxDepth": 12, "SoftTimeMs": 250 },
    "Strong": { "MaxDepth": 18, "SoftTimeMs": 500 }
  }
}
